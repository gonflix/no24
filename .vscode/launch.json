{
    // Java launch configurations for the ticketing app
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch API Server",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/api-server/cmd",
        },
        {
            "type": "java",
            "request": "launch",
            "name": "Launch TicketingApplication",
            "mainClass": "com.ticketing.ticketing.TicketingApplication",
        },
        {
            "type": "java",
            "request": "attach",
            "name": "Attach to Remote (5005)",
            "hostName": "127.0.0.1",
            "port": 5005
        }
    ]
}